agent_chat/messages.jsonl
agent_chat/state.json
agent_chat/state_*.json
agent_chat/tasks.json
agent_chat/uploads/
agent_chat/*.log
agent_chat/*.flag
opinion_claude/*.log
opinion_claude/*.flag
opinion_codex/*.log
opinion_codex/*.flag

# === Migration bundles ===
/runtime-export/

# === UI verification screenshots (regenerable, not committed) ===
/ui-*.png

# === Local config overrides ===
config/*.local.json

# === Node ===
node_modules/

# === Installed agent skills (taste-skill etc.) - reinstallable via `npx skills add`.
